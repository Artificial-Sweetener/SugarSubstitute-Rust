# Default to normalized text handling for the repository.
* text=auto

# Keep source, config, docs, and cube payloads on LF across platforms.
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
integrations/**/*.html text eol=lf
integrations/**/*.css text eol=lf
*.ccx binary
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cube text eol=lf
LICENSE text eol=lf

# Preserve registered artwork hashes across Windows checkouts and browser deployment.
frontend/static/**/*.svg -text
web/**/*.svg -text

# ComfyUI consumes this compiler-owned deployment tree.
web/** linguist-generated=true

# Preserve the original bytes covered by the frame artwork provenance hashes.
frontend/static/orb/*.svg binary
web/orb/*.svg binary

# Windows-native scripts should keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
