{
  "name": "SugarCubes",
  "version": "0.15.3",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "postinstall": "tsx scripts/dependencies/install-codemirror-view.ts",
    "check:dependencies": "tsx scripts/dependencies/install-codemirror-view.ts --check",
    "build": "tsx scripts/build-web.ts",
    "build:check": "tsx scripts/build-web.ts --check",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:list": "python -m tools.test list",
    "test:validate": "python -m tools.test validate",
    "test:all": "python -m tools.test all",
    "test:explain": "python -m tools.test explain",
    "test:run": "python -m tools.test run",
    "test:isolated": "python -m tools.test isolated",
    "test:changed": "python -m tools.test changed",
    "test:staged": "python -m tools.test staged",
    "test:commit": "python -m tools.test staged --commit",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.tests.json --noEmit && tsc --project tsconfig.output-canvas-tests.json --noEmit && python scripts/run_mypy.py",
    "audit:standards": "python scripts/standards_audit.py && tsx scripts/standards-audit.ts",
    "architecture": "python -m tools.check_architecture",
    "architecture:staged": "python -m tools.check_architecture --staged",
    "lint": "eslint \"frontend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "python -m black . --exclude \"\\.venv|node_modules|cubes\" && prettier --write \"frontend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "format:check": "python -m black --check . --exclude \"\\.venv|node_modules|cubes\" && prettier --check \"frontend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "check": "npm run check:dependencies && npm run format:check && python -m ruff check . --exclude node_modules,cubes && npm run audit:standards && npm run architecture && npm run typecheck && npm run lint && npm run build:check && npm run test:all",
    "check:commit": "npm run check",
    "release": "semantic-release"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "esbuild": "0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "private": true,
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "3.1.3",
    "@spectrum-web-components/action-button": "1.12.5",
    "@spectrum-web-components/button": "1.12.5",
    "@spectrum-web-components/checkbox": "1.12.5",
    "@spectrum-web-components/menu": "1.12.5",
    "@spectrum-web-components/slider": "1.12.5",
    "@spectrum-web-components/styles": "1.12.5",
    "@spectrum-web-components/switch": "1.12.5",
    "@spectrum-web-components/tabs": "1.12.5",
    "@spectrum-web-components/textfield": "1.12.5",
    "@spectrum-web-components/theme": "1.12.5",
    "vue": "3.5.43"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@lezer/lr": "1.4.10"
  }
}
