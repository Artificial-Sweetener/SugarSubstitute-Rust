{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialsweetener.ai/schemas/sugarcubes/embedded-panel/v3",
  "title": "SugarCubes embedded panel protocol version 3",
  "$defs": {
    "PanelPresentation": {
      "type": "object",
      "properties": {
        "pluginMode": {
          "type": "boolean"
        },
        "visualStyle": {
          "enum": ["comfy", "fluent", "spectrum", "photopro", "gimp"]
        },
        "photoProPalette": {
          "enum": ["black", "dark-gray", "medium-gray", "light-gray"]
        },
        "accentColor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 7,
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            {
              "const": null
            }
          ]
        },
        "resizeCornerSize": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pluginMode",
        "visualStyle",
        "photoProPalette",
        "accentColor",
        "resizeCornerSize"
      ],
      "additionalProperties": false
    },
    "PanelReady": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.panel"
        },
        "version": {
          "const": 3
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "ready"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "PanelConfigure": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.panel"
        },
        "version": {
          "const": 3
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "configure"
        },
        "presentation": {
          "$ref": "#/$defs/PanelPresentation"
        }
      },
      "required": ["protocol", "version", "session", "type", "presentation"],
      "additionalProperties": false
    },
    "PanelApplied": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.panel"
        },
        "version": {
          "const": 3
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "applied"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "PanelPing": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.panel"
        },
        "version": {
          "const": 3
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "ping"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "PanelPong": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.panel"
        },
        "version": {
          "const": 3
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "pong"
        },
        "connected": {
          "type": "boolean"
        }
      },
      "required": ["protocol", "version", "session", "type", "connected"],
      "additionalProperties": false
    },
    "PanelRejected": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.panel"
        },
        "version": {
          "const": 3
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "rejected"
        },
        "reason": {
          "enum": ["unsupported-presentation", "presentation-failed"]
        }
      },
      "required": ["protocol", "version", "session", "type", "reason"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PanelReady"
    },
    {
      "$ref": "#/$defs/PanelConfigure"
    },
    {
      "$ref": "#/$defs/PanelApplied"
    },
    {
      "$ref": "#/$defs/PanelPing"
    },
    {
      "$ref": "#/$defs/PanelPong"
    },
    {
      "$ref": "#/$defs/PanelRejected"
    }
  ]
}
