{
  "testEnvironment": "jsdom",
  "maxWorkers": 2,
  "roots": ["<rootDir>/tests"],
  "setupFiles": [
    "<rootDir>/tests/frontend_core/support/browser_css.ts",
    "<rootDir>/tests/frontend_core/support/browser_forms.ts"
  ],
  "testMatch": ["**/tests/**/*.test.ts", "**/tests/**/*.spec.ts"],
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "tsconfig.tests.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(?:.*[/\\\\])?MenuControlRuntime\\.js$": "<rootDir>/tests/frontend_core/support/mocks/fluent_menu.ts",
    "^vue$": "<rootDir>/node_modules/vue/index.mjs",
    "^/scripts/app\\.js$": "<rootDir>/tests/frontend_core/support/mocks/app.ts",
    "^/scripts/api\\.js$": "<rootDir>/tests/frontend_core/support/mocks/api.ts",
    "^/scripts/ui\\.js$": "<rootDir>/tests/frontend_core/support/mocks/ui.ts",
    "^/scripts/ui/components/button\\.js$": "<rootDir>/tests/frontend_core/support/mocks/button.ts",
    "^\\.\\./\\.\\./\\.\\./scripts/app\\.js$": "<rootDir>/tests/frontend_core/support/mocks/app.ts",
    "^\\.\\./\\.\\./\\.\\./scripts/api\\.js$": "<rootDir>/tests/frontend_core/support/mocks/api.ts",
    "^\\.\\./\\.\\./\\.\\./scripts/ui\\.js$": "<rootDir>/tests/frontend_core/support/mocks/ui.ts",
    "^\\.\\./\\.\\./\\.\\./scripts/ui/components/button\\.js$": "<rootDir>/tests/frontend_core/support/mocks/button.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
