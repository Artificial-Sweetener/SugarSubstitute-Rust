{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialsweetener.ai/schemas/sugarcubes/release-notes/v1",
  "title": "SugarCubes release notes protocol version 1",
  "description": "An optional protocol for a host that publishes release notes of its own. The page sends watch once the host description lists sugarcubes.release-notes; the host answers with its product name and running version, and sends a new state, with a higher revision, whenever they change. The host sends open when the user asks the host to show what is new; the page then shows its release notes view. load asks for the published notes of every version after since, through the running version; a since that is not older than the running version asks for the running version alone. The host answers each load by its request name with notes, newest version first, or with failed. notes text is the Markdown the release's changelog holds for that version. omitted counts the older versions in the range left out to keep the message within its bound. unavailable means the notes could not be read now and a retry may succeed; not-published means the release repository has no notes for the running version. Versions are lowercase release tokens; product is a plain display name.",
  "$defs": {
    "ReleaseNotesFailure": {
      "enum": ["unavailable", "not-published"]
    },
    "ReleaseNotesRelease": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9.-]{1,64}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": ["version", "notes"],
      "additionalProperties": false
    },
    "ReleaseNotesStateMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.release-notes"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "state"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "product": {
          "type": "string",
          "maxLength": 64
        },
        "currentVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9.-]{1,64}$"
        }
      },
      "required": [
        "protocol",
        "version",
        "session",
        "type",
        "revision",
        "product",
        "currentVersion"
      ],
      "additionalProperties": false
    },
    "ReleaseNotesOpenMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.release-notes"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "open"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "ReleaseNotesNotesMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.release-notes"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "notes"
        },
        "request": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9.-]{1,48}$"
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReleaseNotesRelease"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["protocol", "version", "session", "type", "request", "releases", "omitted"],
      "additionalProperties": false
    },
    "ReleaseNotesFailedMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.release-notes"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "failed"
        },
        "request": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9.-]{1,48}$"
        },
        "reason": {
          "$ref": "#/$defs/ReleaseNotesFailure"
        }
      },
      "required": ["protocol", "version", "session", "type", "request", "reason"],
      "additionalProperties": false
    },
    "ReleaseNotesWatchMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.release-notes"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "watch"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "ReleaseNotesLoadMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.release-notes"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "load"
        },
        "request": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9.-]{1,48}$"
        },
        "since": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9.-]{1,64}$"
        }
      },
      "required": ["protocol", "version", "session", "type", "request", "since"],
      "additionalProperties": false
    },
    "ReleaseNotesHostMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/ReleaseNotesStateMessage"
        },
        {
          "$ref": "#/$defs/ReleaseNotesOpenMessage"
        },
        {
          "$ref": "#/$defs/ReleaseNotesNotesMessage"
        },
        {
          "$ref": "#/$defs/ReleaseNotesFailedMessage"
        }
      ]
    },
    "ReleaseNotesClientMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/ReleaseNotesWatchMessage"
        },
        {
          "$ref": "#/$defs/ReleaseNotesLoadMessage"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ReleaseNotesStateMessage"
    },
    {
      "$ref": "#/$defs/ReleaseNotesOpenMessage"
    },
    {
      "$ref": "#/$defs/ReleaseNotesNotesMessage"
    },
    {
      "$ref": "#/$defs/ReleaseNotesFailedMessage"
    },
    {
      "$ref": "#/$defs/ReleaseNotesWatchMessage"
    },
    {
      "$ref": "#/$defs/ReleaseNotesLoadMessage"
    }
  ]
}
