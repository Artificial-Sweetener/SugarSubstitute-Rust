      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "unsupported",
            "invalid",
            "too-large",
            "stale",
            "cancelled",
            "untrusted-origin",
            "unavailable",
            "identity-mismatch",
            "quota",
            "storage",
            "migration-required",
            "opted-out",
            "not-committed"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "entryId": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 36
            },
            {
              "const": null
            }
          ]
        },
        "outputId": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 36
            },
            {
              "const": null
            }
          ]
        }
      },
      "required": ["code", "retryable", "entryId", "outputId"],
      "additionalProperties": false
    },
    "SessionOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ready"
            },
            "capabilities": {
              "$ref": "#/$defs/SessionCapabilities"
            },
            "committed": {
              "type": "boolean"
            },
            "workflowPersistence": {
              "type": "boolean"
            },
            "fence": {
              "$ref": "#/$defs/SessionFence"
            }
          },
          "required": ["kind", "capabilities", "committed", "workflowPersistence", "fence"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "capture"
            },
            "fence": {
              "$ref": "#/$defs/SessionFence"
            },
            "checkpointId": {
              "type": "string",
              "maxLength": 36
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "fence", "checkpointId", "revision"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "materialize"
            },
            "fence": {
              "$ref": "#/$defs/SessionFence"
            },
            "transferId": {
              "type": "string",
              "maxLength": 36
            }
          },
          "required": ["kind", "fence", "transferId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "begin"
            },
            "transfer": {
              "$ref": "#/$defs/SessionTransfer"
            }
          },
          "required": ["kind", "transfer"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "chunk"
            },
            "transferId": {
              "type": "string",
              "maxLength": 36
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8191
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "required": ["kind", "transferId", "index", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "commit"
            },
            "transferId": {
              "type": "string",
              "maxLength": 36
            }
          },
          "required": ["kind", "transferId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cancel"
            },
            "targetRequestId": {
              "type": "string",
              "maxLength": 36
            }
          },
          "required": ["kind", "targetRequestId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "acknowledged"
            },
            "checkpointId": {
              "type": "string",
              "maxLength": 36
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "phase": {
              "enum": ["captured", "materialized", "durable", "restored", "cancelled"]
            },
            "bindings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SessionBinding"
              },
              "maxItems": 256
            }
          },
          "required": ["kind", "checkpointId", "revision", "phase", "bindings"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "error"
            },
            "failure": {
              "$ref": "#/$defs/SessionFailure"
            }
          },
          "required": ["kind", "failure"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resolve"
            },
            "output": {
              "$ref": "#/$defs/SessionOutput"
            }
          },
          "required": ["kind", "output"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resolved"
            },
            "outputId": {
              "type": "string",
              "maxLength": 36
            },
            "digest": {
              "type": "string",
              "maxLength": 64
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8589934592
            },
            "file": {
              "$ref": "#/$defs/SessionFile"
            }
          },
          "required": ["kind", "outputId", "digest", "bytes", "file"],
          "additionalProperties": false
        }
      ]
    },
    "SessionMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.desktop-session"
        },
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "maxLength": 36
        },
        "scope": {
          "$ref": "#/$defs/SessionScope"
        },
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "operation": {
          "$ref": "#/$defs/SessionOperation"
        }
      },
      "required": ["protocol", "version", "requestId", "scope", "origin", "operation"],
      "additionalProperties": false
    },
    "SessionNavigation": {
      "type": "object",
      "properties": {
        "sceneOverview": {
          "type": "boolean"
        },
        "sceneId": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 36
            },
            {
              "const": null
            }
          ]
        },
        "sourceId": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 36
            },
            {
              "const": null
            }
          ]
        },
        "batchIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "batchOverview": {
          "type": "boolean"
        }
      },
      "required": ["sceneOverview", "sceneId", "sourceId", "batchIndex", "batchOverview"],
      "additionalProperties": false
    },
    "SessionInspection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["fit", "native", "custom"]
        },
        "centerX": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "centerY": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "spanX": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 1000000000000.0
        },
        "spanY": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 1000000000000.0
        }
      },
      "required": ["mode", "centerX", "centerY", "spanX", "spanY"],
      "additionalProperties": false
    }
  }
}
