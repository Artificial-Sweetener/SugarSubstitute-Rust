  "capabilities": [
    {
      "name": "presentation.host-styles",
      "meaning": "The host's configured presentation replaces the user's saved appearance while embedded."
    },
    {
      "name": "presentation.system-accent",
      "meaning": "The host's configured accent is the system accent, offered as a choice beside a custom one."
    },
    {
      "name": "output.host-surface",
      "meaning": "The host presents output images itself; the page never falls back to browser images."
    },
    {
      "name": "updates.product-name",
      "meaning": "Besides sugarcubes.updates version 1, the host answers version 2 on the same channel, whose states name the product they describe."
    },
    {
      "name": "session-notice.lines",
      "meaning": "Besides sugarcubes.session-notice version 1, the host answers version 2 on the same channel, whose notices include lines the host words itself."
    },
    {
      "name": "canvas.backdrop-regions",
      "meaning": "The host takes up to 64 acrylic regions in one canvas geometry message, where a host without this takes two."
    }
  ]
