{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialsweetener.ai/schemas/sugarcubes/backend/v1",
  "title": "SugarCubes backend protocol version 1",
  "description": "An optional protocol for a host that runs the ComfyUI the page talks to. The page sends watch once the host description lists sugarcubes.backend; the host answers every watch with a state, and sends a new state, with a higher revision, whenever it changes. running says ComfyUI is up as far as the host knows. stopped says it ended and the host is still settling what it left. retry-ready says the host can start it again when asked. retrying says a restart is under way. The page asks for that restart with retry, naming the revision of the retry-ready state it saw; the host ignores a retry that names any other state. Starting ComfyUI again is the host's decision alone: a retry grants the page nothing else.",
  "$defs": {
    "BackendStatus": {
      "enum": ["running", "stopped", "retry-ready", "retrying"]
    },
    "BackendStateMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.backend"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "state"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "#/$defs/BackendStatus"
        }
      },
      "required": ["protocol", "version", "session", "type", "revision", "status"],
      "additionalProperties": false
    },
    "BackendWatchMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.backend"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "watch"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "BackendRetryMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.backend"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "retry"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["protocol", "version", "session", "type", "revision"],
      "additionalProperties": false
    },
    "BackendClientMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/BackendWatchMessage"
        },
        {
          "$ref": "#/$defs/BackendRetryMessage"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/BackendStateMessage"
    },
    {
      "$ref": "#/$defs/BackendWatchMessage"
    },
    {
      "$ref": "#/$defs/BackendRetryMessage"
    }
  ]
}
