{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialsweetener.ai/schemas/sugarcubes/update-report/v1",
  "title": "SugarCubes update report protocol version 1",
  "description": "An optional protocol for a host that keeps its own report of an update that failed or needs attention, with more detail than the page shows and the means to copy or export it. The page sends watch once the host description lists sugarcubes.update-report; the host answers every watch with a state, and sends a new state, with a higher revision, whenever it changes. available says the host has a report to show now. The page asks the host to show it with open, naming the revision of the state it saw; the host shows its own window over the application, or brings an open one forward, and ignores an open while it has nothing to report. Showing the report is the host's decision alone: an open grants the page nothing else.",
  "$defs": {
    "UpdateReportStateMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.update-report"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "state"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": ["protocol", "version", "session", "type", "revision", "available"],
      "additionalProperties": false
    },
    "UpdateReportWatchMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.update-report"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "watch"
        }
      },
      "required": ["protocol", "version", "session", "type"],
      "additionalProperties": false
    },
    "UpdateReportOpenMessage": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "sugarcubes.update-report"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9-]{16,80}$"
        },
        "type": {
          "const": "open"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["protocol", "version", "session", "type", "revision"],
      "additionalProperties": false
    },
    "UpdateReportClientMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/UpdateReportWatchMessage"
        },
        {
          "$ref": "#/$defs/UpdateReportOpenMessage"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/UpdateReportStateMessage"
    },
    {
      "$ref": "#/$defs/UpdateReportWatchMessage"
    },
    {
      "$ref": "#/$defs/UpdateReportOpenMessage"
    }
  ]
}
