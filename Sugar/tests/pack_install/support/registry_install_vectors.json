  "replacements": [
    {
      "name": "update-keeps-untracked-user-data",
      "installed": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.0.0\"\n",
          "__init__.py": "old",
          "removed.py": "gone in new",
          "web/old.js": "old js",
          ".sugarcubes/library.cube": "user cube",
          ".env": "SECRET=kept",
          "web/user-note.txt": "user note"
        },
        "tracking": "pyproject.toml\n__init__.py\nremoved.py\nweb/old.js"
      },
      "release": [
        {
          "name": "pyproject.toml",
          "kind": "file",
          "text": "[project]\nname = \"SugarCubes\"\nversion = \"1.1.0\"\n"
        },
        {
          "name": "__init__.py",
          "kind": "file",
          "text": "new"
        },
        {
          "name": "lib/",
          "kind": "directory"
        },
        {
          "name": "lib/added.py",
          "kind": "file",
          "text": "added"
        }
      ],
      "expect": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.1.0\"\n",
          "__init__.py": "new",
          "lib/added.py": "added",
          ".sugarcubes/library.cube": "user cube",
          ".env": "SECRET=kept",
          "web/user-note.txt": "user note"
        },
        "absent": [
          "removed.py",
          "web/old.js"
        ],
        "trackingEntries": [
          "pyproject.toml",
          "__init__.py",
          "lib/",
          "lib/added.py"
        ]
      }
    },
    {
      "name": "untracked-file-where-release-puts-one-is-restored-on-rollback",
      "installed": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.0.0\"\n",
          "__init__.py": "old",
          "config.json": "user settings"
        },
        "tracking": "pyproject.toml\n__init__.py"
      },
      "release": [
        {
          "name": "pyproject.toml",
          "kind": "file",
          "text": "[project]\nname = \"SugarCubes\"\nversion = \"1.1.0\"\n"
        },
        {
          "name": "__init__.py",
          "kind": "file",
          "text": "new"
        },
        {
          "name": "config.json",
          "kind": "file",
          "text": "{}"
        }
      ],
      "expect": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.1.0\"\n",
          "__init__.py": "new",
          "config.json": "{}"
        },
        "absent": [],
        "trackingEntries": [
          "pyproject.toml",
          "__init__.py",
          "config.json"
        ]
      }
    }
  ],
