  "ownership": [
    {
      "name": "registry-install",
      "folder": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "tracking": "pyproject.toml\r\n__init__.py"
      },
      "expect": {
        "owned": true,
        "version": "1.2.3"
      }
    },
    {
      "name": "git-checkout-directory",
      "folder": {
        "git": "directory",
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "tracking": "pyproject.toml\n__init__.py"
      },
      "expect": {
        "owned": false,
        "reason": "git-checkout"
      }
    },
    {
      "name": "git-worktree-file",
      "folder": {
        "git": "file",
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "tracking": "pyproject.toml\n__init__.py"
      },
      "expect": {
        "owned": false,
        "reason": "git-checkout"
      }
    },
    {
      "name": "no-tracking",
      "folder": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "tracking": null
      },
      "expect": {
        "owned": false,
        "reason": "not-registry-install"
      }
    },
    {
      "name": "tracking-without-pyproject",
      "folder": {
        "files": {
          "__init__.py": ""
        },
        "tracking": "__init__.py"
      },
      "expect": {
        "owned": false,
        "reason": "not-registry-install"
      }
    },
    {
      "name": "unsafe-tracking",
      "folder": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "tracking": "__init__.py\n../../custom_nodes/other/__init__.py"
      },
      "expect": {
        "owned": false,
        "reason": "invalid-tracking"
      }
    },
    {
      "name": "linked-pack-folder",
      "folder": {
        "link": true,
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "tracking": "pyproject.toml\n__init__.py"
      },
      "expect": {
        "owned": false,
        "reason": "linked-folder"
      }
    },
    {
      "name": "tracked-directory-is-a-link",
      "folder": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": ""
        },
        "linkedDirectories": [
          "web"
        ],
        "tracking": "pyproject.toml\n__init__.py\nweb/app.js"
      },
      "expect": {
        "owned": false,
        "reason": "linked-content"
      }
    },
    {
      "name": "tracked-file-is-now-a-directory",
      "folder": {
        "files": {
          "pyproject.toml": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n",
          "__init__.py": "",
          "nodes.py/inner.py": ""
        },
        "tracking": "pyproject.toml\n__init__.py\nnodes.py"
      },
      "expect": {
        "owned": false,
        "reason": "linked-content"
      }
    }
  ],
