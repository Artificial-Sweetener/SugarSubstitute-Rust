{
  "schema": 1,
  "description": "Language-neutral vectors for the Comfy Registry install format of a node pack. Every implementation (SugarCubes in Python, the Substitute host in Rust) must consume this file unchanged. Entries are forward-slash relative paths; a trailing slash marks a directory. `.tracking` is the entries joined by the platform line separator (CRLF on Windows, LF elsewhere) with no trailing separator; readers accept LF or CRLF and skip blank lines. Error and reason codes are the format's typed outcomes. A member `kind` is file, directory or symlink; `text` is UTF-8 file content; `unixMode` is the octal Unix mode stored in the zip external attributes when given. `.tracking-digests.json` (schema 1) records the SHA-256 of every tracked file for offline local-edit detection; it applies only when its `tracking` equals the SHA-256 of the exact `.tracking` bytes, its `version` equals the installed version, and its `files` keys equal the tracked file paths exactly; otherwise it is ignored and the installed release is compared with the published one.",
  "trackingParse": [
    {
      "name": "manager-crlf-no-trailing-separator",
      "text": "README.md\r\n.gitignore\r\npyproject.toml\r\n__init__.py\r\n.github/workflows/publish.yml",
      "expect": {
        "entries": [
          "README.md",
          ".gitignore",
          "pyproject.toml",
          "__init__.py",
          ".github/workflows/publish.yml"
        ]
      }
    },
    {
      "name": "lf-with-blank-lines-and-directory-entry",
      "text": "web/\n\nweb/app.js\n__init__.py\n",
      "expect": {
        "entries": [
          "web/",
          "web/app.js",
          "__init__.py"
        ]
      }
    },
    {
      "name": "empty-record-owns-nothing",
      "text": "",
      "expect": {
        "entries": []
      }
    },
    {
      "name": "parent-escape",
      "text": "__init__.py\n../outside.py",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "absolute-posix",
      "text": "/etc/passwd",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "windows-drive",
      "text": "C:/Windows/win.ini",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "backslash-separator",
      "text": "sub\\file.py",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "alternate-data-stream",
      "text": "__init__.py:hidden",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "dot-segment",
      "text": "a/./b.py",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "empty-segment",
      "text": "a//b.py",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "trailing-dot-segment",
      "text": "folder./file.py",
      "expect": {
        "error": "unsafe-path"
      }
    },
    {
      "name": "surrounding-whitespace-is-stripped-as-manager-does",
      "text": " __init__.py",
      "expect": {
        "entries": [
          "__init__.py"
        ]
      }
    },
    {
      "name": "windows-device-name",
      "text": "aux.py",
      "expect": {
        "error": "reserved-name"
      }
    },
    {
      "name": "git-metadata",
      "text": ".git/config",
      "expect": {
        "error": "reserved-name"
      }
    },
    {
      "name": "tracking-tracks-itself",
      "text": ".tracking",
      "expect": {
        "error": "reserved-name"
      }
    },
    {
      "name": "case-insensitive-duplicate",
      "text": "Readme.md\nREADME.md",
      "expect": {
        "error": "duplicate-entry"
      }
    },
    {
      "name": "file-used-as-directory",
      "text": "nodes.py\nnodes.py/inner.py",
      "expect": {
        "error": "entry-conflict"
      }
    }
  ],
  "trackingRender": [
    {
      "name": "archive-order-is-kept",
      "entries": [
        "pyproject.toml",
        "__init__.py",
        "web/",
        "web/app.js"
      ],
      "lfText": "pyproject.toml\n__init__.py\nweb/\nweb/app.js",
      "crlfText": "pyproject.toml\r\n__init__.py\r\nweb/\r\nweb/app.js"
    }
  ],
  "archives": [
    {
      "name": "flat-registry-layout",
      "members": [
        {
          "name": "pyproject.toml",
          "kind": "file",
          "text": "[project]\nname = \"SugarCubes\"\nversion = \"1.2.3\"\n"
        },
        {
          "name": "__init__.py",
          "kind": "file",
          "text": "VERSION = '1.2.3'\n"
        },
        {
          "name": "web/",
          "kind": "directory"
        },
        {
          "name": "web/app.js",
          "kind": "file",
          "text": "export {};\n"
        }
      ],
      "expect": {
        "entries": [
          "pyproject.toml",
          "__init__.py",
          "web/",
          "web/app.js"
        ]
      }
    },
    {
      "name": "empty-archive",
      "members": [],
      "expect": {
        "error": "empty-archive"
      }
    },
    {
      "name": "directories-only",
      "members": [
        {
          "name": "web/",
          "kind": "directory"
        }
      ],
      "expect": {
        "error": "empty-archive"
      }
    },
