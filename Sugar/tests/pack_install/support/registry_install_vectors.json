  ],
  "archiveLimits": [
    {
      "name": "declared-size-over-file-limit",
      "limits": {
        "maxEntries": 10,
        "maxTotalBytes": 1000,
        "maxFileBytes": 8
      },
      "members": [
        {
          "name": "big.bin",
          "kind": "file",
          "text": "0123456789"
        }
      ],
      "expect": {
        "error": "too-large"
      }
    },
    {
      "name": "too-many-members",
      "limits": {
        "maxEntries": 2,
        "maxTotalBytes": 1000,
        "maxFileBytes": 1000
      },
      "members": [
        {
          "name": "a.py",
          "kind": "file",
          "text": ""
        },
        {
          "name": "b.py",
          "kind": "file",
          "text": ""
        },
        {
          "name": "c.py",
